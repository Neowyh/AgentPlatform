{
  "$schema": "https://qodo.ai/schema/cover-config.json",
  "framework": "vitest",
  "testDir": "tests/unit",
  "sourceDir": "src",
  "conventions": {
    "testFilePattern": "{source}.test.{ext}",
    "testDirMirror": true,
    "importAlias": "@",
    "mockPattern": "vi.mock",
    "componentTesting": {
      "library": "@testing-library/react",
      "matchers": "@testing-library/jest-dom/vitest",
      "cleanup": true,
      "dataTestid": true
    },
    "apiTesting": {
      "mockModule": "@/core/api/fetcher",
      "pattern": "vi.mock then dynamic import"
    }
  },
  "coverage": {
    "provider": "v8",
    "include": ["src/**/*.{ts,tsx}"],
    "exclude": [
      "src/**/*.d.ts",
      "src/**/*.stories.{ts,tsx}",
      "src/app/layout.tsx"
    ]
  },
  "quality": {
    "minAssertions": 2,
    "testEdgeCases": true,
    "errorPathTesting": true,
    "avoidSnapshotTests": true
  }
}
