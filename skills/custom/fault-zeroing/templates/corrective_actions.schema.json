{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fault Zeroing Corrective Actions",
  "type": "object",
  "required": ["corrective_actions"],
  "properties": {
    "corrective_actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/corrective_action"
      }
    }
  },
  "$defs": {
    "corrective_action": {
      "type": "object",
      "required": [
        "id",
        "name",
        "description",
        "target_root_cause_id",
        "completion_criteria"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "target_root_cause_id": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "completion_criteria": {
          "type": "string"
        },
        "priority": {
          "type": "string",
          "enum": ["high", "medium", "low"]
        },
        "status": {
          "type": "string",
          "enum": ["planned", "in_progress", "completed"]
        }
      }
    }
  }
}
