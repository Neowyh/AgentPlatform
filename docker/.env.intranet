# iDeer Intranet Build Configuration
# Set these to your internal mirror addresses

# Docker base images (internal Harbor/Registry)
NODE_IMAGE=harbor.internal.com/library/node:22-alpine
PYTHON_IMAGE=harbor.internal.com/library/python:3.12-slim-bookworm
NGINX_IMAGE=harbor.internal.com/library/nginx:alpine
DOCKER_CLI_IMAGE=harbor.internal.com/library/docker:cli
UV_IMAGE=harbor.internal.com/library/uv:0.7.20

# Package mirrors
UV_INDEX_URL=https://pypi.internal.com/simple
NPM_REGISTRY=https://npm.internal.com
APT_MIRROR=deb.debian.internal.com

# NodeSource (set to empty to skip NodeSource and use pre-installed Node)
NODESOURCE_URL=

# Sandbox image
SANDBOX_IMAGE=harbor.internal.com/ideer/all-in-one-sandbox:latest
