# iDeer knowledge-dev RAGFlow profile — local environment.
#
# Copy this file to docker/ragflow/.env (git-ignored) and fill in the values
# for your intranet. It is consumed via Compose's --env-file, so every
# ${RAGFLOW_*} reference in docker/docker-compose-knowledge-dev.yaml resolves
# from here for ALL services consistently:
#
#   cp docker/ragflow/.env.example docker/ragflow/.env
#   docker compose -p ideer-dev \
#     -f docker/docker-compose-dev.yaml \
#     -f docker/docker-compose-knowledge-dev.yaml \
#     --env-file docker/ragflow/.env up -d ragflow
#
# Secrets policy: API keys and intranet endpoint URLs must only ever live in
# this untracked file. Never commit docker/ragflow/.env or hardcode keys into
# tracked files. Do not set COMPOSE_* variables (COMPOSE_PROFILES,
# COMPOSE_PROJECT_NAME, ...) in here — this file is project-agnostic input.

# ── RAGFlow image ─────────────────────────────────────────────────────────
# Pinned upstream version. For intranet hosts, pre-load the images into the
# local Docker daemon (docker load from the internal mirror, or docker pull
# via a mirror while online) so startup needs no public network.
RAGFLOW_IMAGE=infiniflow/ragflow:v0.27.1

# ── Intranet embedding endpoint (tenant-default seed) ─────────────────────
# All three values must be set together for the seed to take effect; leave
# them empty to configure the provider in the RAGFlow UI after first boot.
# The base URL must be reachable from the ragflow container — use
# host.docker.internal for host services, or the bundled TEI service below.
RAGFLOW_EMBEDDING_BASE_URL=
RAGFLOW_EMBEDDING_API_KEY=
RAGFLOW_EMBEDDING_MODEL_NAME=
# Example A — bundled TEI service (start with: --profile tei):
#   RAGFLOW_EMBEDDING_BASE_URL=http://ragflow-tei:80/v1
#   RAGFLOW_EMBEDDING_API_KEY=sk-tei-local
#   RAGFLOW_EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
# Example B — vLLM on the host (OpenAI-compatible):
#   RAGFLOW_EMBEDDING_BASE_URL=http://host.docker.internal:8000/v1
#   RAGFLOW_EMBEDDING_API_KEY=sk-intranet-xxx
#   RAGFLOW_EMBEDDING_MODEL_NAME=bge-m3

# ── Bundled TEI embedding service (--profile tei, defaults shown) ──────────
# RAGFLOW_TEI_IMAGE=infiniflow/text-embeddings-inference:cpu-1.8
# RAGFLOW_TEI_MODEL=BAAI/bge-small-en-v1.5
# RAGFLOW_TEI_PORT=9997
# Model download defaults to huggingface.co (direct). hf-mirror.com is known
# to break TEI 1.8 downloads (missing etag header) — only override
# RAGFLOW_TEI_ENDPOINT with a mirror proven to work in your environment:
# RAGFLOW_TEI_ENDPOINT=
# For hosts without any public route, pre-load the model into the
# ragflow-tei-data volume (huggingface_hub cache layout) while online and set:
# RAGFLOW_TEI_OFFLINE=1

# ── Infra passwords (defaults = RAGFlow upstream dev values) ──────────────
# Override all of them for anything beyond a personal dev host. Because they
# resolve here for every service and healthcheck at once, no service can end
# up with a mismatched value.
# RAGFLOW_MYSQL_PASSWORD=infini_rag_flow
# RAGFLOW_MINIO_USER=rag_flow
# RAGFLOW_MINIO_PASSWORD=infini_rag_flow
# RAGFLOW_REDIS_PASSWORD=infini_rag_flow
# RAGFLOW_ELASTIC_PASSWORD=infini_rag_flow

# ── Host port / bind overrides (defaults shown) ───────────────────────────
# Ports bind to 127.0.0.1 unless RAGFLOW_BIND_HOST is changed.
# RAGFLOW_BIND_HOST=127.0.0.1
# RAGFLOW_HTTP_PORT=9380
# RAGFLOW_WEB_PORT=8080
# RAGFLOW_ES_PORT=1200
# RAGFLOW_MYSQL_PORT=4455
# RAGFLOW_MINIO_PORT=9002
# RAGFLOW_MINIO_CONSOLE_PORT=9003
# RAGFLOW_REDIS_PORT=6381

# ── Resource tuning (defaults shown) ──────────────────────────────────────
# RAGFLOW_MEM_LIMIT=8073741824
# RAGFLOW_ES_JAVA_OPTS=-Xms1g -Xmx1g
# RAGFLOW_TZ=Asia/Shanghai
# RAGFLOW_REGISTER_ENABLED=1
