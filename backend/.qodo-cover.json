{
  "$schema": "https://qodo.ai/schema/cover-config.json",
  "framework": "pytest",
  "testDir": "tests",
  "sourceDir": ["app", "packages"],
  "conventions": {
    "testFilePattern": "test_{module}.py",
    "classBased": true,
    "asyncSupport": true,
    "markers": {
      "asyncio": "async test functions",
      "no_auto_user": "disable autouse contextvar fixture",
      "allow_blocking_io": "opt out of Blockbuster gate",
      "requires_llm": "tests that need LLM API access"
    },
    "fixtures": {
      "_auto_user_context": "autouse contextvar for user context",
      "_router_auth_helpers.make_authed_test_app()": "authenticated FastAPI test app",
      "_agent_e2e_helpers.FakeToolCallingModel": "fake model for agent tests"
    },
    "patterns": {
      "parametrize": "use @pytest.mark.parametrize for edge cases",
      "happyAndError": "test both happy path and error cases",
      "isolation": "use setup_method/teardown_method for state isolation"
    }
  },
  "exclude": [
    "**/__pycache__/**",
    "**/migrations/**",
    "**/conftest.py"
  ]
}
